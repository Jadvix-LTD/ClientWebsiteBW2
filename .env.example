# Public URL of the live site (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.bwense.com

# Google Analytics 4 measurement ID. Only loaded after the visitor accepts analytics cookies.
# NEXT_PUBLIC_GA_ID is not used on this site (no analytics cookies)

# Google Search Console HTML-tag verification code (the content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Enquiry form email delivery (SMTP of the business mailbox) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Mailbox that receives quote requests
ENQUIRY_TO=enquiries@bwense.com
# "From" address used when sending (usually the same as SMTP_USER)
ENQUIRY_FROM=
